# Generate .env and offline Influx token using python scripts/bootstrap.py.
SENSOGRID_MODE=ble
SENSOGRID_BIND=127.0.0.1
SENSOGRID_PORT=8097
SENSOGRID_INFLUX_DATABASE=sensogrid
SENSOGRID_INFLUX_TOKEN=
SENSOGRID_SECURE_COOKIES=false
# Optional standards-based Web Push; browser push network service is external.
SENSOGRID_VAPID_PRIVATE_KEY=
SENSOGRID_VAPID_PUBLIC_KEY=
SENSOGRID_VAPID_SUBJECT=mailto:admin@example.invalid

# Reverse proxy IP(s) trusted for X-Forwarded-Proto (TLS).
SENSOGRID_PROXY_IPS=127.0.0.1

# Maximum parallel BLE connections; reduce if the adapter is limited.
SENSOGRID_BLE_CONCURRENCY=10
